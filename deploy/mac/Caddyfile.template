# Caddy: единственное, что смотрит в интернет. Терминирует HTTPS и проксирует
# всё на приложение, которое слушает только 127.0.0.1:8787.
#
# Шаблон: setup.sh подставит поддомен, token и почту и положит результат
# в /opt/homebrew/etc/Caddyfile (права 600 — внутри token).
#
# ПОЧЕМУ ПОРТ 8443, А НЕ 443
# Роутер Vodafone держит внешние 80 и 443 под свой веб-интерфейс и не даёт их
# пробросить: «port is reserved for internal usage». Поэтому наружу выведен 8443,
# и адрес дашборда — https://ПОДДОМЕН.duckdns.org:8443
#
# ПОЧЕМУ DNS-ПРОВЕРКА
# Обычная проверка Let's Encrypt (HTTP-01) требует входящий порт 80, а он занят
# роутером. acme_dns решает задачу иначе: Caddy сам кладёт TXT-запись через API
# DuckDNS, и входящие порты для выпуска сертификата не нужны вообще. Нужен
# бинарник caddy с модулем dns.providers.duckdns — обычный из Homebrew его
# не содержит, setup.sh скачивает сборку с ним.
#
# ПОЧЕМУ ДВА ИМЕНИ
# Роутер не разворачивает запрос к своему внешнему адресу изнутри сети (нет NAT
# hairpinning), поэтому из дома внешнее имя не открывается. Второй поддомен
# DuckDNS, «-lan», указывает прямо на локальный адрес мака: из дома он ведёт
# напрямую, снаружи не работает вовсе — и это нормально, каждый адрес для своего
# случая. Сертификат Caddy получает на оба имени, предупреждений нет нигде.
# Строку АДРЕСА подставляет setup.sh; если «-lan» не заведён, останется одно имя.

{
	email ВАША-ПОЧТА
	acme_dns duckdns ВАШ-TOKEN

	# порт 80 занять всё равно не получится — незачем и пытаться
	auto_https disable_redirects
}

АДРЕСА {
	encode zstd gzip

	# дашборд для одного человека: отдавать его поисковикам смысла нет
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# X-Forwarded-For и X-Forwarded-Proto Caddy проставляет сам, поэтому
	# ограничитель попыток входа видит реальный IP клиента, а не 127.0.0.1.
	reverse_proxy 127.0.0.1:8787 {
		# первичная синхронизация кошелька сканирует логи по всем сетям
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
