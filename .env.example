# Скопируйте в .env и поправьте. Файл .env в git не попадает.

# --- доступ -------------------------------------------------------------------
# Применяется ОДИН РАЗ, при создании пустой базы. Потом меняется через manage.py.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Ключ подписи сессионной куки. Если пусто — сгенерируется в data/secret_key.
SECRET_KEY=

# Включить, только если дашборд выставлен наружу и работает по HTTPS.
SESSION_HTTPS_ONLY=false

# --- сеть ---------------------------------------------------------------------
HOST=127.0.0.1
PORT=8787

# --- блокчейн -----------------------------------------------------------------
ENABLED_CHAINS=ethereum,arbitrum,base,polygon,optimism,bsc

# Свой RPC приоритетнее публичных. Один на все сети:
# RPC_URL=https://eth-mainnet.g.alchemy.com/v2/КЛЮЧ
# ...или по сетям (снимает лимит на диапазон блоков в eth_getLogs — история
# собирается за секунды вместо минут):
# RPC_ETHEREUM=
# RPC_ARBITRUM=
# RPC_BASE=
# RPC_POLYGON=
# RPC_OPTIMISM=
# RPC_BSC=

# Секунд на сканирование логов одной сети
HISTORY_BUDGET=240

# --- расписание (секунды) -----------------------------------------------------
LIVE_INTERVAL=60          # состояние активных позиций
SYNC_INTERVAL=86400       # поиск новых позиций и событий
SNAPSHOT_INTERVAL=900     # точка на графике капитала
SCHEDULER_ENABLED=true

# --- алерты -------------------------------------------------------------------
ALERT_HEALTH_FACTOR=1.15
ALERT_OUT_OF_RANGE=true

# Пауза против «дребезга»: цена у границы диапазона может ходить туда-сюда,
# и без неё это превратится в поток сообщений. Секунды.
ALERT_COOLDOWN=1800

# --- уведомления в Telegram ---------------------------------------------------
# 1. Создайте бота у @BotFather, получите токен
# 2. Напишите своему боту любое сообщение
# 3. .venv/bin/python manage.py notify-chatid   — покажет ваш chat_id
# 4. Впишите оба значения сюда и проверьте: manage.py notify-test
NOTIFY_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ежедневная сводка ------------------------------------------------------------
# Одно сообщение в Telegram раз в сутки: изменение чистой стоимости, собранные и
# несобранные комиссии, минимальный health factor, сколько позиций вне диапазона и
# сколько времени они провели внутри. Проверить вид и цифры, не дожидаясь утра:
#   .venv/bin/python manage.py digest
DIGEST_ENABLED=true
# Время МЕСТНОЕ — то, которое показывают часы на этой машине, а не UTC.
DIGEST_TIME=09:00

# Ссылка на дашборд, которая уходит в сообщения
PUBLIC_URL=http://127.0.0.1:8787
